# lbgca — environment. Copy to lbgca.env (chmod 600), never commit the real file.
# The defaults below are the hosh.it box values: copying this file unchanged is enough, then SECRET_KEY is
# generated ON THE BOX (DEPLOY.md, never printed). `hosh-deploy register` checks the names on the
# `# required:` line are non-empty (values are never printed).
# required: SECRET_KEY

# --- deployment ---
# The only line hosh-deploy changes (one release tag per deploy).
APP_IMAGE='ghcr.io/pazka/lbgca:v1.2.0'
APP_BIND='127.0.0.1:9141'

# --- app ---
# Flask SECRET_KEY: 64 hex chars, generated on the box (DEPLOY.md §1b C). Not used to sign sessions today
# (Flask-Session ids are server-side), but required so it never falls back to a per-boot random value.
SECRET_KEY=
# PORT=8000, DATA_DIR=/data, STATIC_DIR=/data/static are fixed in docker-compose.example.yml.
